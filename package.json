{
  "name": "vesta",
  "version": "1.3.0",
  "private": true,
  "description": "Ultra-strict React + TypeScript workspace template for AI-assisted development.",
  "license": "(MIT OR Apache-2.0)",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.1.0",
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "bun run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsr generate && tsc --noEmit",
    "lint": "biome lint .",
    "lint:rules": "bun run scripts/lint-rules.ts",
    "lint:all": "biome check . && bun run scripts/lint-rules.ts",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "check:ci": "biome check .",
    "knip": "knip",
    "size": "size-limit",
    "licenses": "license-checker-rseidelsohn --production --excludePrivatePackages --onlyAllow 'MIT;MIT*;ISC;Apache-2.0;Apache 2.0;BSD-2-Clause;BSD-3-Clause;BSD;0BSD;CC0-1.0;CC-BY-4.0;Unlicense;Python-2.0;BlueOak-1.0.0'",
    "pr": "bun run lint:all && bun run typecheck && bun run knip && bun run licenses && bun run test:run && bun run build && bun run size",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^7.0.3",
    "@tanstack/react-query": "^5.107.0",
    "@tanstack/react-router": "^1.170.46",
    "clsx": "^2.1.1",
    "framer-motion": "^14.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@size-limit/file": "^14.3.0",
    "@size-limit/preset-app": "^14.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/router-cli": "^1.167.46",
    "@tanstack/router-plugin": "^1.168.48",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "knip": "^6.44.1",
    "license-checker-rseidelsohn": "^5.0.1",
    "lint-staged": "^17.6.0",
    "size-limit": "^14.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^5.1.0"
  }
}
