{
  "name": "vesta",
  "version": "1.3.0",
  "private": true,
  "description": "Ultra-strict React + TypeScript workspace template for AI-assisted development.",
  "license": "(MIT OR Apache-2.0)",
  "type": "module",
  "packageManager": "bun@1.1.34",
  "engines": {
    "bun": ">=1.1.0",
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "bun run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "lint:rules": "bun run scripts/lint-rules.ts",
    "lint:all": "biome check . && bun run scripts/lint-rules.ts",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "check:ci": "biome check .",
    "knip": "knip",
    "size": "size-limit",
    "licenses": "license-checker-rseidelsohn --production --excludePrivatePackages --onlyAllow 'MIT;MIT*;ISC;Apache-2.0;Apache 2.0;BSD-2-Clause;BSD-3-Clause;BSD;0BSD;CC0-1.0;CC-BY-4.0;Unlicense;Python-2.0;BlueOak-1.0.0'",
    "pr": "bun run lint:all && bun run typecheck && bun run knip && bun run licenses && bun run test:run && bun run build && bun run size",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "dependencies": {
    "@base-ui-components/react": "^1.0.0-rc.0",
    "@hookform/resolvers": "^3.10.0",
    "@tanstack/react-query": "^5.62.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.54.0",
    "react-router-dom": "^7.0.0",
    "tailwind-merge": "^3.0.0",
    "zod": "^3.24.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@size-limit/file": "^11.1.6",
    "@size-limit/preset-app": "^11.1.6",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@commitlint/types": "^20.5.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/coverage-v8": "^4.0.15",
    "autoprefixer": "^10.4.22",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.2",
    "jsdom": "^27.0.0",
    "knip": "^6.13.1",
    "license-checker-rseidelsohn": "^4.4.2",
    "size-limit": "^11.1.6",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^4.0.15"
  }
}
